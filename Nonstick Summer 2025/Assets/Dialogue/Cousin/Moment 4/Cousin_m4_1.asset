    BranchingDialogue: {fileID: 11400000, guid: db35aa4caf8f0e842bd0eaadc61c1435, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "I mean, I live here. Why wouldn\u2019t I show up?"
