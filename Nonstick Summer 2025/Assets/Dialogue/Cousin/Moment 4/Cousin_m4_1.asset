    CombinedDialogue: []
    PlayerDialogue: "Yeah, yeah. I\u2019ve missed you, too."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: "Uh, good! I\u2019ve been good! Mostly. Y\u2019know. Busy. But good!"
