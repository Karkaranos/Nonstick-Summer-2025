  dialogue:
  - Dialogue: Okay. Um, how about this?
    Portrait: {fileID: 0}
  - Dialogue: I've brought my cards with me! From way back when!
    Portrait: {fileID: 0}
  - Dialogue: Maybe we could play a round? Like we used to?
    Portrait: {fileID: 0}
  - Dialogue: I'll warn you that I'm probably, like, REALLY rusty.
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Oh! Really? Okay! I\u2019ll be waiting, then!"
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Oh, wow! Uh, later. I\u2019ve got something to do first."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Right. Right... Can\u2019t believe I bothered..."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: dac4ae234837d7b4d86d19d9b2e91671, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "I didn\u2019t want to play then and I don\u2019t want to play
      now."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Oh, really? That\u2019s, um... That\u2019s a little crazy. But hey,
        we can still try later, right? Right..."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    CombinedDialogue:
    - Dialogue: "Oh, really? That\u2019s, um... That\u2019s a little crazy. But hey,
        we can still try later, right? Right..."
      Portrait: {fileID: 0}
    - Dialogue: "Uhm...so what\u2019s the deal with your mom?"
      Portrait: {fileID: 0}
    - Dialogue: 'I tried telling her a joke and she just got mad with me. '
      Portrait: {fileID: 0}
    - Dialogue: "I think she\u2019s angry about something...I dunno.\u201D "
      Portrait: {fileID: 0}
    - Dialogue: They got a little mixed up, though
      Portrait: {fileID: 0}
    PlayerDialogue: "I, um, haven\u2019t really played in a long time, either."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Oh, really? That\u2019s, um... That\u2019s a little crazy. But hey,
        we can still try later, right? Right..."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Oh, man. I\u2019d kinda forgotten about these things..."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Observation:
