    BranchingDialogue: {fileID: 11400000, guid: dac4ae234837d7b4d86d19d9b2e91671, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "You\u2019re trying way, WAY too hard."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: You really think so? Haha! How time flies...
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    CombinedDialogue: []
    PlayerDialogue: Heh. You probably remember how the game works better than I do
      nowadays.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Charming_Question:
    NpcReactionText:
    - Dialogue: "Of course I do! They meant a lot to me, you know! Uh... Let me know
        when, alright? I\u2019m free whenever, I guess."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    CombinedDialogue:
