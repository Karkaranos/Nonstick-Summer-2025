  dialogue:
  - Dialogue: Um... You like me, right? Like, you think I'm cool?
    Portrait: {fileID: 0}
  - Dialogue: Because I think you're the coolest! But, uh...
    Portrait: {fileID: 0}
  - Dialogue: You look mad right now. Are you mad at me?
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: You do?! I mean, of course you do!
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    CombinedDialogue: []
    PlayerDialogue: Of course I like you!
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: I think I'm kinda cool...
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Um... I like you, I guess. But you\u2019re not cool."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Haha, yeah! I\u2019m the coolest!"
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "...I\u2019m not mad. You\u2019re cool."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: ...I am? Oh...
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "I like you! You\u2019re just kinda annoying, sometimes."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "I am NOT! I am not! I\u2019ve been a fan for longer than you have!
        I mean it!"
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "I know you\u2019re a poser. You only like these cards because
      I do. Copycat!"
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "I am NOT! I am not! I\u2019ve been a fan for longer than you have!
        I mean it!"
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "You\u2019re cool... I know you\u2019re lying about liking these
