    PlayerDialogue: "What?! You can\u2019t do that!"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 40}
    BranchingDialogueHigh: {fileID: 11400000, guid: 4caad9d0af48eb240be10ca7efaad70d, type: 2}
