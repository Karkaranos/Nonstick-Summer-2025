  m_Name: EVILCousin_m2_6 1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: ...You look mad right now. Are you mad at me?
    Portrait: {fileID: 21300000, guid: 3bf1a18b00c42fa46a3891a38cbfb232, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  - Dialogue: Because I think you're the coolest! And, uh...
    Portrait: {fileID: 21300000, guid: 05bc7261fc317ac44b10debbe34988d4, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  - Dialogue: Well, uhm...
    Portrait: {fileID: 21300000, guid: 3bf1a18b00c42fa46a3891a38cbfb232, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  - Dialogue: ...W-we're still friends, right?
    Portrait: {fileID: 21300000, guid: 3bf1a18b00c42fa46a3891a38cbfb232, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  - Dialogue: Like, you think I'm cool?
    Portrait: {fileID: 21300000, guid: 3bf1a18b00c42fa46a3891a38cbfb232, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  Charming_Expression:
    NpcReactionText:
    - Dialogue: You do?! I mean, of course you do!
      Portrait: {fileID: 21300000, guid: d1da91c30447c3f4993c88d7851b5b9f, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Of course I like you. I just need my space, y\u2019know?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "I am NOT! I am not! I\u2019ve been a fan for longer than you have!
        I mean it!"
      Portrait: {fileID: 21300000, guid: 05bc7261fc317ac44b10debbe34988d4, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "I know you\u2019re a poser. You only like these cards because
      I do. Copycat!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: Haha, I AM the coolest! And, uh... oh, yeah! Yeah, I can do that!
      Portrait: {fileID: 21300000, guid: d1da91c30447c3f4993c88d7851b5b9f, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m not mad. You\u2019re cool. But leave opening my gifts
      to me next time. Please?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 3ba94a470affee44393fd0e66f864382, type: 2}
