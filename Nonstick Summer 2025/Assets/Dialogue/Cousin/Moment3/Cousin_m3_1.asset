  dialogue:
  - Dialogue: Hey! Hope you are ready for the big game.
    Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
    AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: How ya feeling?
    Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Awesome!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I\u2019m gonna watch the whole thing!"
      Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Great! I\u2019m ready to go out there and get this trophy!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 877cded020acf444d81fa7c4eac91068, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Oh, okay!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "Didn\u2019t mean to distract you."
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Not right now. I\u2019m a bit busy."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 877cded020acf444d81fa7c4eac91068, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m glad!"
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I\u2019m sure he would have loved to see you play."
