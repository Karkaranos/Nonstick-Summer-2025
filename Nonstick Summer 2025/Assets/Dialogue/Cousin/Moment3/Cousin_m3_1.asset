  - Dialogue: How are you feeling?
    Portrait: {fileID: 21300000, guid: 31cc8c56635d5ba42b7943fdba18efcd, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Awesome!
      Portrait: {fileID: 21300000, guid: d1da91c30447c3f4993c88d7851b5b9f, type: 3}
    - Dialogue: " I\u2019ll be sure to take notes for when I go out there and try
        to get a trophy of my own!"
      Portrait: {fileID: 21300000, guid: 31cc8c56635d5ba42b7943fdba18efcd, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "Great! I\u2019m ready to go out there and get this trophy!"
