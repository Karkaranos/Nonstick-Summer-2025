      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Feeling good. I\u2019m going out there for Grandpa today."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 877cded020acf444d81fa7c4eac91068, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "That\u2019s awesome! I\u2019ll be sure to take notes for when I
        try to get a trophy of my own!"
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Never better, looks like the weather is going to be perfect today
      for my performance.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 877cded020acf444d81fa7c4eac91068, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: Oh...sorry to hear that. Still, I know that you gonna do great out
        there!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Alright, I woke up with a crick in my neck, so I\u2019m already
      not 100%."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 877cded020acf444d81fa7c4eac91068, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: Sorry to hear that. Still, I know that you gonna do great out there!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: A bit nervous. I was tossing and turning all night just thinking
      about the game.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 877cded020acf444d81fa7c4eac91068, type: 2}
