  m_Name: Cousin_m3_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Oh! Listen!
    Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
    AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "I got some more cards the other day, and I\u2019ve been itching to
      try them out."
    Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Wanna play a round or two?
    Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Right!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Yeah.
      Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Neutral
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Of course.
      Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Neutral
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Maybe some other time, then.
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m a bit busy... I\u2019m not sure if I have the time."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 49dc780579956e849ae90b220a1124f8, type: 2}
