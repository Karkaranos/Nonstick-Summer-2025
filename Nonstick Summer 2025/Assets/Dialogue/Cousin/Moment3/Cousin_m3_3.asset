  m_Name: Cousin_m3_3
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: But back to soccer. Uhm...
    Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: So, I was thinking about joining the team next year.
    Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Would you be willing to show me a thing or two to get a head start?
    Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: It would be great to start learning from someone as good at it as you!
    Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Awesome!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I won\u2019t let you down I promise."
      Portrait: {fileID: 21300000, guid: 07a16ebe9ca74b449aabb5ea5ff298d4, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I\u2019ll be sure to train as hard as I can so that I can be just
        as good as you someday!"
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Sure, I\u2019d be down to help you out at any time."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: ae4ec5c1a4d2a7f4388624996d3dcf02, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Oh...
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Alright.
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I guess you\u2019re right."
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: I should just stay in my lane.
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Haha.
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Hmm. I don\u2019t know if you\u2019ve got the make for it."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: ae4ec5c1a4d2a7f4388624996d3dcf02, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "What makes you think that I wouldn\u2019t like playing soccer?!"
      Portrait: {fileID: 21300000, guid: d9f460e8723d80c4d97fa30b8b578f7e, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "Are you just saying that because you don\u2019t want to..."
