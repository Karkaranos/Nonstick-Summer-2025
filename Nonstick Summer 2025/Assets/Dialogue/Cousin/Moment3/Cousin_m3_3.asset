      AnimatedReaction: {fileID: 0}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Never mind...
      Portrait: {fileID: 21300000, guid: 556a340b0f8af914d961138973a178c3, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "I don\u2019t know... You should find something that YOU really
      like to do."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: ae4ec5c1a4d2a7f4388624996d3dcf02, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Awesome! I won\u2019t let you down. I promise!"
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I\u2019ll be sure to train as hard as I can so that I can be just
        as good as you someday."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: I barely made the team my first year. I can definitely give you
      some tips and tricks.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: ae4ec5c1a4d2a7f4388624996d3dcf02, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: Oh...I guess you're right.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: I should just stay in my lane and play my games.
