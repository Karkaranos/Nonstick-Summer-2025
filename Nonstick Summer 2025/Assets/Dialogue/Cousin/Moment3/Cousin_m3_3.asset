    ChangeInRelationshipStatus: 15
  Assertive_Question:
    NpcReactionText:
    - Dialogue: I am!
      Portrait: {fileID: 21300000, guid: d1da91c30447c3f4993c88d7851b5b9f, type: 3}
    - Dialogue: "I\u2019m ready to try something new, I swear!"
      Portrait: {fileID: 21300000, guid: d1da91c30447c3f4993c88d7851b5b9f, type: 3}
    - Dialogue: I know that you can give me the best tips, too!
      Portrait: {fileID: 21300000, guid: d1da91c30447c3f4993c88d7851b5b9f, type: 3}
    CombinedDialogue: []
    PlayerDialogue: Are you sure you would be up for it?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
