      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "I\u2019ll follow everything you say to the letter!"
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Promise!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: I could make the time for it. You ready to learn from the master?
