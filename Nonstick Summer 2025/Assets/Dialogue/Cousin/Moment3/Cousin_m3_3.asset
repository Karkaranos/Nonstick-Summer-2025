      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: I swear!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: I know that you can give me the best tips, too!
      Portrait: {fileID: 21300000, guid: 0609dabf022fb3a4f99a6098a82c6ede, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Are you sure you would be up for it?
    RelationshipCheckRequired: 0
