  m_Name: Cousin_m4_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Ugh! This is so weird!
    Portrait: {fileID: 21300000, guid: 9291a82ed0f216746b4c5f0064e64c27, type: 3}
    AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
    AudioResponse: Angry
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: I mean.. I used to sort of idolize you. Did you know that?
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: We, uh, probably weren't as close as I thought, but...
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: ...
    Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Sad
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: I don't know! I missed talking to you.
    Portrait: {fileID: 21300000, guid: 9291a82ed0f216746b4c5f0064e64c27, type: 3}
    AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
    AudioResponse: Angry
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Sorry if that's, like, lame. Or whatever.
    Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Sad
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Good. I mean, cool. I mean, whatever! I mean...
      Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Thank you.
      Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Neutral
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Really.
      Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Heh. It wasn\u2019t. You\u2019re cool."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 86dc334325df0fd4ea9b68cea78d8375, type: 2}
