      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Ugh. You\u2019ve always been desperate for approval like this..."
