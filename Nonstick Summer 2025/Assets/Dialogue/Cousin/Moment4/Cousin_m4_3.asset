  dialogue:
  - Dialogue: Okay. Um, how about this?
    Portrait: {fileID: 0}
  - Dialogue: I've brought my cards with me! From way back when!
    Portrait: {fileID: 0}
  - Dialogue: Maybe we could play a round? Like we used to?
    Portrait: {fileID: 0}
  - Dialogue: I'll warn you that I'm probably, like, REALLY rusty.
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Oh, really? That\u2019s, um... That\u2019s a little crazy."
      Portrait: {fileID: 0}
    - Dialogue: But hey, we can still try later, right?
      Portrait: {fileID: 0}
    - Dialogue: Right...
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Oh, man. I\u2019d kinda forgotten about these things..."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: 'Right. Right... '
      Portrait: {fileID: 0}
    - Dialogue: "Can\u2019t believe I bothered..."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "You\u2019re trying way, WAY too hard."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: You really think so? Haha! How time flies...
      Portrait: {fileID: 0}
    CombinedDialogue:
    - Dialogue: "Oh, really? That\u2019s, um... That\u2019s a little crazy. But hey,
        we can still try later, right? Right..."
      Portrait: {fileID: 0}
    - Dialogue: "Uhm...so what\u2019s the deal with your mom?"
      Portrait: {fileID: 0}
    - Dialogue: 'I tried telling her a joke and she just got mad with me. '
      Portrait: {fileID: 0}
    - Dialogue: "I think she\u2019s angry about something...I dunno.\u201D "
      Portrait: {fileID: 0}
    - Dialogue: They got a little mixed up, though
      Portrait: {fileID: 0}
    PlayerDialogue: Heh. You probably remember how the game works better than I do
      nowadays.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
