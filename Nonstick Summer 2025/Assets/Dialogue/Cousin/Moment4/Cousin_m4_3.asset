    ChangeInRelationshipStatus: 10
  Charming_Question:
    NpcReactionText:
    - Dialogue: Of course I do! They meant a lot to me, you know?
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    - Dialogue: "Uh... Let me know when, alright? I\u2019m free whenever, I guess."
      Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Neutral
    CombinedDialogue:
    - Dialogue: "Of course I do! They meant a lot to me, you know! Uh... Let me know
        when, alright? I\u2019m free whenever, I guess."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: "Uhm...so what\u2019s the deal with your mom?"
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: 'I tried telling her a joke and she just got mad with me. '
      Portrait: {fileID: 0}
