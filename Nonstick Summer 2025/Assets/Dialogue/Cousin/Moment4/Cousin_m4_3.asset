    - Dialogue: "I think she\u2019s angry about something...I dunno.\u201D "
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    PlayerDialogue: Do you still have the cards that I gave you?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8374d955cfa518c49b157a30bbbb88dc, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Question:
    NpcReactionText:
    - Dialogue: ...Ugh. Was it really so wrong that I wanted to be close to you?
      Portrait: {fileID: 21300000, guid: 9291a82ed0f216746b4c5f0064e64c27, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    CombinedDialogue: []
    PlayerDialogue: "Don\u2019t you have anything that you like doing on your own?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: dac4ae234837d7b4d86d19d9b2e91671, type: 2}
