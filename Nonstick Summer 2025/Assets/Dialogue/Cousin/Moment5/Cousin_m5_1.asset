  dialogue:
  - Dialogue: "Heya! Bet you\u2019re just SO relieved that I\u2019m here, huh?"
    Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Happy
  - Dialogue: "...I\u2019m joking, mostly. But I\u2019m glad that I made it."
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: "This is really it, huh? What\u2019s it feel like?"
    Portrait: {fileID: 0}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s, um, good! In a good way..."
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "Like I\u2019m going to explode, but in a good way."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2a1d747ba0718ff44bff5918ad724fc8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Oh... Really? Well, we\u2019ll all miss you. You know that, right?"
      Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue: []
    PlayerDialogue: "Like I\u2019m happy to finally be getting out of here."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2a1d747ba0718ff44bff5918ad724fc8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: Oh. Oh! Uh...
      Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Neutral
    - Dialogue: "I'm...I\u2019m sorry. I wasn\u2019t, uh, prepared for that."
      Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue:
    - Dialogue: "Oh. Oh! Um... I\u2019m sorry. I wasn\u2019t, uh, prepared for that."
      Portrait: {fileID: 21300000, guid: 3bf1a18b00c42fa46a3891a38cbfb232, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: "It\u2019s... It\u2019s a lot, isn\u2019t it?  I mean, I\u2019d imagine!
        It is for me, at least."
      Portrait: {fileID: 21300000, guid: 31cc8c56635d5ba42b7943fdba18efcd, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: "I\u2019m not too far behind you... That\u2019s scary!"
      Portrait: {fileID: 21300000, guid: 3bf1a18b00c42fa46a3891a38cbfb232, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: "But that\u2019s besides the point! I\u2019ll get there when I get
        there. For now..."
      Portrait: {fileID: 21300000, guid: 05bc7261fc317ac44b10debbe34988d4, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: Well, are you ready?
      Portrait: {fileID: 21300000, guid: 31cc8c56635d5ba42b7943fdba18efcd, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    PlayerDialogue: Like I wish I had gotten to know you some more.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
