    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 5
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: ...Thank you. That means a lot to me. Really.
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
