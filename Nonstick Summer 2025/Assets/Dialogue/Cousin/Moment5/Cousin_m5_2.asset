  Charming_Question:
    NpcReactionText:
    - Dialogue: "Right? The few years that you have on me feel so much more significant
        when we were younger than they do now, don\u2019t they?"
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Oh, wow. I guess that you really aren\u2019t that much younger
      than I am, are you?"
    RelationshipCheckRequired: 1
