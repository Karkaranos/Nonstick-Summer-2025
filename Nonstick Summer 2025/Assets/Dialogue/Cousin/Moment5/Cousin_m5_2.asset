    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
