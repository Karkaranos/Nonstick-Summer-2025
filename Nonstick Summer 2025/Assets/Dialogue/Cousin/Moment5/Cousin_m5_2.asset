    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: "Right? The few years that you have on me feel so much more significant
        when we were younger than they do now, don\u2019t they?"
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "Oh, wow. I guess you really aren\u2019t that much younger than
      I am, are you?"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 0
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "No? I mean, I guess not, but that\u2019s a sad way of describing
        this, isn\u2019t it?"
      Portrait: {fileID: 21300000, guid: 9291a82ed0f216746b4c5f0064e64c27, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    - Dialogue: "I\u2019d think that a part of me would be happy to go out there
        and thrive..."
      Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: Would you be ready to leave your entire life behind?
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 0
  Sappy_Question:
    NpcReactionText:
    - Dialogue: "Don\u2019t say that! That\u2019s SO embarrassing."
      Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Happy
    - Dialogue: Heh...
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "It\u2019s weird to imagine you heading off to college so soon.
      You\u2019re still my baby cousin, you know?"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
