  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Cousin_m5_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: "It\u2019s... It\u2019s a lot, isn\u2019t it? I mean, I\u2019d imagine!
      It is for me, at least."
    Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  - Dialogue: "I\u2019m not too far behind you... preeetty scary."
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  - Dialogue: "But that\u2019s besides the point! I\u2019ll get there when I get
      there. For now..."
    Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  - Dialogue: Well? Are you ready?
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I just knew you\u2019d be! That\u2019s great. That\u2019s a little
        assuring, too..."
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "As ready as I\u2019ll ever be."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 0
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Ah...Well, for what it\u2019s worth, that\u2019s nice to hear."
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Neutral
    - Dialogue: "That means that I\u2019ll be okay when it\u2019s my turn, even if
        I\u2019m not ready, either."
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "I don\u2019t think that I could ever be ready..."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 0
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: ...Thank you. That means a lot to me. Really.
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "No... I\u2019m happy that you\u2019re here, you know? It\u2019s
      like I don\u2019t have to move on quite yet."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 0
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "I just knew you\u2019d be! That\u2019s great. That\u2019s a little
        assuring, too..."
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "It is scary, but it\u2019s not so bad. I\u2019m ready enough."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 34, y: 66}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 00d99fbfd81bb814ba8a8581990c0261, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 23465bd5add45ac4a92ec2cb600f965f, type: 2}
    ChangeInRelationshipStatus: 0
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "I just knew you\u2019d be! That\u2019s great. That\u2019s a little
        assuring, too..."
      Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "Don\u2019t be so presumptuous. I\u2019m doing fine, and I\u2019m
      ready."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 25c20d56825af0e418987e10505e1db2, type: 2}
