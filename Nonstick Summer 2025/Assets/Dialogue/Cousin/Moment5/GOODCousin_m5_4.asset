  m_Name: GOODCousin_m5_4
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Anyways...
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "Look. I know that it must\u2019ve been hard when we were both younger."
    Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Sad
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Dealing with Grandpa, with my dad, and, well
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: ...with me.
    Portrait: {fileID: 21300000, guid: 6506522cd75f2404d91e8fb4738abf28, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Sad
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "And even when we couldn\u2019t hang out as much anymore..."
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "Look, what I\u2019m trying to say is that you were my first friend.
      You were my best friend for awhile, whether the feeling was mutual or not.  "
    Portrait: {fileID: 21300000, guid: 2071a3956799eac499fe06278e1f69e1, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "If it wasn\u2019t? That\u2019s fine. I\u2019m glad that you were there
      for me at all."
    Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "Thank you. We\u2019ll see each other again soon, right?"
    Portrait: {fileID: 21300000, guid: bf08644dbaefc5a4ba15ddce9653347b, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
