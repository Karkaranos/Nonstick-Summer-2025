  m_Name: Grandma_m1_1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: "There\u2019s my little sunshine, has Mommy been treating you alright
      recently?"
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: I'm happy to hear that, dear.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    CombinedDialogue:
    - Dialogue: Hehehe, well... I taught your Mommy how to be fun, so you will love
        playing with me!
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 0}
    - Dialogue: Are these your blocks? Do you want Nanna to help you? Maybe we could
        build a house.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 0}
    PlayerDialogue: Nanna, Mommy and I have been having so much fun!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84564766d880e7e49ab172adf96cf104, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t you worry your little heart my little pumpkin, Nanna
        is here now to save you from evil Momma!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    CombinedDialogue:
    - Dialogue: "Don\u2019t you worry your little heart my little pumpkin, Nanna
