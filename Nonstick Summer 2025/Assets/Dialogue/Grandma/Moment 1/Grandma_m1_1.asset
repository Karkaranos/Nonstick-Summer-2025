    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    NpcReactionText:
    - Dialogue: You know what we say about lying my little pumpkin, and if she learned
        anything from me I already know you guys have been having a blast!
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "Momma has been sooo mean, you wouldn\u2019t be mean to me right
      Nanna?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84564766d880e7e49ab172adf96cf104, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "Ouch! That\u2019s a bit hurtful pumpkin. Come on, let Nanna help
