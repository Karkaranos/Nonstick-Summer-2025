    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "...Well, Nanna is happy to see you! Come now, let\u2019s play."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "Momma is always tired. We don\u2019t get to play much anymore."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84564766d880e7e49ab172adf96cf104, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "It\u2019s called perfume, honey...a perfume called Classic Rose...."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    CombinedDialogue: []
    PlayerDialogue: Grandma... you smell like an old person...
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84564766d880e7e49ab172adf96cf104, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: Well, Nanna is here. Maybe you can teach me how to play.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    CombinedDialogue: []
    PlayerDialogue: I thought Mommy was going to play with me.... I only play games
      with her....
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84564766d880e7e49ab172adf96cf104, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: Well, Nanna is here.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "Mommy\u2019s been real busy recently."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84564766d880e7e49ab172adf96cf104, type: 2}
