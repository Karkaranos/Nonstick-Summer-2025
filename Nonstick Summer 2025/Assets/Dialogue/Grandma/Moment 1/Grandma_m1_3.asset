    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "It\u2019s okay to be nervous, sunshine, though I\u2019m sure you\u2019ll
