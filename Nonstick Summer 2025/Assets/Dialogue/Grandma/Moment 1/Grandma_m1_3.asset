      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: No, I never want to go to school! School is STUPID.
