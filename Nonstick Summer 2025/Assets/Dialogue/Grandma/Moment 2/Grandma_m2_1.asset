  m_Name: Grandma_m2_1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Oh, hello, Pumpkin. Did you like your cake?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Haha, I\u2019m glad you liked it, honey. It was baked with lots
        of love."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: Yes!! It was sooooooo good....
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Well... That\u2019s sweet of you to say honey, but you can be honest
        with your Nanna. I\u2019m getting a bit older so I might not be as on top
        of it as I used to."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    - Dialogue: "I\u2019ll be sure to make the best cake I\u2019ve ever made for
        you next time!"
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "It wasn\u2019t exactly as I remember... I liked it because you\u2019re
      the one who made it."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Well, part of throwing a party is sharing... You\u2019d want your
        Cousin to share his cake with you at his next birthday, right?"
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
    - Dialogue: So make sure to share as much as possible now so everyone else will
        share with you on their birthday.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "It was good, but cousin ate so much of it that there\u2019s
      not much left... Ugh"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Oh silly, don\u2019t gobble it all down! And make sure to ask your
        mom before you eat a bunch at once. Savor it!"
      Portrait: {fileID: 0}
    CombinedDialogue:
    - Dialogue: "Oh silly, don\u2019t gobble it all down! And make sure to ask your
        mom before you eat a bunch at once. Savor it!"
      Portrait: {fileID: 0}
    - Dialogue: Now, have you come to help your Nanna clean the kitchen?
      Portrait: {fileID: 0}
    PlayerDialogue: Yes.. the left overs better be for me!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Well... I\u2019m sorry to hear that honey. I thought you\u2019d
        like it."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: It tasted like cardboard.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
