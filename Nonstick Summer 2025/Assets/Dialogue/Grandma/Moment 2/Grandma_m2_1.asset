  m_Name: Grandma_m2_1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Oh, hello, Pumpkin. Did you like your cake?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Haha, I\u2019m glad you liked it, honey. It was baked with lots
        of love."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: Yes!! It was sooooooo good....
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s sweet of you, honey, but you can be honest. I\u2019m
        getting a bit older, but next year, I\u2019ll be sure to make an even better
        one for you."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "It wasn\u2019t exactly as I remember... I liked it because you\u2019re
      the one who made it."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Oh, silly, don\u2019t gobble it all down!"
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Sad
    - Dialogue: And make sure to ask your mom before you eat a bunch at once. Savor
        it!
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "It was good, but cousin ate so much of it that there\u2019s
      not much left..."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 84ad6ee3cd3e33145ac51fe5e47a2a25, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Oh silly, don\u2019t gobble it all down! And make sure to ask your
