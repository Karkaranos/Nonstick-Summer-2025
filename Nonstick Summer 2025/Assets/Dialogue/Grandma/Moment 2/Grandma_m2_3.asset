  Sappy_Question:
    NpcReactionText:
    - Dialogue: "I guess you\u2019re right. Silly me. Why don\u2019t you send your
        cousin in here to help me out instead?"
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue: []
    PlayerDialogue: "I\u2019d rather not on my birthday. Why don\u2019t you ask someone
