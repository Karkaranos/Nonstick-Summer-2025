  dialogue:
  - Dialogue: You better be good...
    Portrait: {fileID: 0}
  - Dialogue: Otherwise, no extra cake for you!
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Well.. no cake for those who don\u2019t want more! Early striker
        gets the sugar, hehe. Maybe I should bring it home with me instead, or give
        it to your cousin...."
      Portrait: {fileID: 0}
    CombinedDialogue:
    - Dialogue: "Well.. no cake for those who don\u2019t want more! Early striker
        gets the sugar, hehe. Maybe I should bring it home with me instead, or give
        it to your cousin...."
      Portrait: {fileID: 0}
    - Dialogue: Have you said hi to your Cousin yet?
      Portrait: {fileID: 0}
    - Dialogue: It's always so nice to see the two of you playing...
      Portrait: {fileID: 0}
    - Dialogue: I don't think I've ever heard him laugh as much as he does with you.
      Portrait: {fileID: 0}
    PlayerDialogue: Maybe I already had all the cake I wanted before!
