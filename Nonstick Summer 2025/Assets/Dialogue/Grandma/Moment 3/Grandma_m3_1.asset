  m_Name: Grandma_m3_1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Hello Pumpkin, you look like you're ready for the big game!
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s the spirit."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    - Dialogue: "I know you\u2019ve put in a ton of hard work, I just wish everyone
        could see just how amazing you\u2019ve become."
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "You know it! Nanna\u2019s Pumpkin is going to put on a show
      with their amazing skills!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "It\u2019s pretty obvious just looking at you, your hard work is
        really paying off."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    - Dialogue: I just know you are going to be great out there with confidence like
        that.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "Thank you, I\u2019ve been training really hard for this."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Come on, don\u2019t think like that, remember all the time and effort
        you put into practicing for this game."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    - Dialogue: You are more than ready!
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "I know you\u2019re just saying that..."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: Thank you very much, my little charmer!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: Right back at ya Grandma! You're looking good today!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: I know I do, but I am serious. I can already tell that you're going
        to put on a great show!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: You always say that kind of stuff.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: I really mean it, watching you play never fails to put a smile on
        my face!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "I know you\u2019re just saying that..."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Question:
    NpcReactionText:
    - Dialogue: "Oh, I\u2019m certain. I can already tell that you are going to put
        on a show!"
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    - Dialogue: I just wish everyone was here to see it.
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue: []
    PlayerDialogue: "I didn\u2019t know it was so obvious. Do you really mean it?!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
