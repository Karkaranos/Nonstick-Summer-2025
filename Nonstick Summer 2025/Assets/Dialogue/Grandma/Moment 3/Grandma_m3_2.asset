  m_Name: Grandma_m3_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: How has your mother been? Has she been treating you well?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "You don\u2019t have to lie to me if it isn\u2019t, pumpkin."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue: []
    PlayerDialogue: You know us! Right as rain, just like we always are!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "You don\u2019t have to lie to me if it isn\u2019t, pumpkin."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue: []
    PlayerDialogue: Fine.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m sorry to hear that. Ever since your grandfather passed,
        everyone\u2019s been a bit on edge. Just give your mother some time."
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "We haven\u2019t really had much time together. Not like before."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "That\u2019s great to hear, I\u2019m glad everything seems to be
        smooth sailing."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
    - Dialogue: "I was worried that Grandpa\u2019s passing would throw everything
        for a loop."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: "As always, she\u2019s the one that\u2019s making sure I\u2019m
      staying on top of my training schedule."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Sorry, you\u2019re right. I guess I was just in my head a bit."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: You have to be focused if you want to help win that trophy.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: 'That is an odd thing that bring up at a time like this. '
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: I was worried that might be the case...
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: Just give your mother some time.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: "I know we all need time after going through something like your
        grandfather\u2019s passing."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: "It\u2019s been a bit rough lately, I just hope that she isn\u2019t
      biting off more than she can chew."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Charming_Question:
    NpcReactionText:
    - Dialogue: "I know how hard she\u2019s been working, but that\u2019s still no
        excuse. Even so, try not to blame her."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    - Dialogue: "I\u2019m sure she\u2019s doing her best."
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "Does working all day and not coming to the biggest game of the
      season count as \u201Cwell\u201D?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "I\u2019m doing better now, thank you."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Sad
    - Dialogue: "Don\u2019t worry about me, though."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    - Dialogue: Keep your mind on the game!
