    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Charming_Question:
    NpcReactionText:
    - Dialogue: Looking at you in your uniform all ready to kick some butt at the
        game reminded me of it.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    - Dialogue: "I know you\u2019ll make us proud like that again."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: I could never forget it, what makes you bring it up now?
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
