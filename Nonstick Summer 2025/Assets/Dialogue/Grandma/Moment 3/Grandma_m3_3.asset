  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Grandma_m3_3
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Do you remember that match that your grandfather and I were able to
      make it to? The one where you made the winning shot?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "You remember that? I told you, I wasn\u2019t sleeping, I was...oh
        well."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: Of course! Just try not to fall asleep in the crowd this time.
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    ChangeInRelationshipStatus: -15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Oh pumpkin, don\u2019t linger on that. That was an accident, and
        you\u2019ve improved so much."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: I remember the faces you made when I tripped over the ball last
      week.
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Me too...but we can\u2019t dwell too much on the past."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    - Dialogue: The rest of our lives are ahead of us.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: I really miss those days.
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: We were completely taken aback.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
    - Dialogue: To think that my little pumpkin could do something as awesome as
        that!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: I remember I scored the game winning goal. The looks on your
      faces afterwards were just incredible.
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: ...Well, just know that you will make us proud like that again.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: All of us.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: "I don\u2019t have time to talk about that right now Grandma."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: We were completely taken aback.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    - Dialogue: To think that my little pumpkin could do something as awesome as
        that!
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: I still remember the faces you guys made right after I scored
      that game winning goal.
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Charming_Question:
    NpcReactionText:
    - Dialogue: "You were. I just wish your grandfather could see you now...he\u2019d
        be so proud."
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "I remember it like it was yesterday. Wasn\u2019t I amazing out
      there?"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    ChangeInRelationshipStatus: -10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: I just know it.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Neutral
    CombinedDialogue:
    - Dialogue: I just thought it was really cool, and just know that you will make
        us proud like that again.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: All of us.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: "Alright, I\u2019ll leave you to it then."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    PlayerDialogue: " Do you think today\u2019s gonna go that well?"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    ChangeInRelationshipStatus: 10
  Sappy_Question:
    NpcReactionText:
    - Dialogue: I do! He and I were both so proud to see our little pumpkin out there.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    - Dialogue: If only he were here to see you today...he would be just as proud.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: Do you remember how loud Grandpa cheered?
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
