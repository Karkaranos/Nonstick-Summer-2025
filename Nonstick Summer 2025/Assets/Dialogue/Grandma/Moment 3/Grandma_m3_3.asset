  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Grandma_m3_3
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Do you remember that soccer game a couple years ago that grandpa and
      I made it to?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Right? Who could ever forget such an amazing game. I was so proud
        of you in that moment.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    - Dialogue: "I know you\u2019ll make us feel the exact same way tonight. I just
        know it!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: Of course! I could never forget that game.
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: ba9b6e42745907d4c86bb46deb7362be, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 78ccc5e5c15ba7f4f8ea82ba2de38c55, type: 2}
    ChangeInRelationshipStatus: -15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Right? Who could ever forget such an amazing game. I was so proud
