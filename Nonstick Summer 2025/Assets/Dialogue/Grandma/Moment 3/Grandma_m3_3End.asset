      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "Yeah, do you still remember the look on Grandpa\u2019s face
