  dialogue:
  - Dialogue: Oh... hello Pumpkin.
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m glad to see you too, dear."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    PlayerDialogue: "There\u2019s my super Nanna! Glad you could come visit."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
