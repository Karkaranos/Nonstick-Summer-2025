--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Grandma_m4_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: My, where has the time gone...
    Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
  - Dialogue: Who knew that my little Pumpkin could grow so tall?
    Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Oh, I\u2019m sure she has."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Well, Mom\u2019s made sure to keep me on a balanced diet of
      milk, meat and radioactive materials to enhance my height."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: ..Right. Sorry, I must have forgotten.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "I said not to call me that anymore. I\u2019m not a kid."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "You remember that? You were so young, and always trying to stand
        on your toes when you thought I wasn\u2019t looking."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: I miss when you used to measure me on the doorway back at the
      old house.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Now, there\u2019s no need for harsh words."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Well, it seems like you\u2019ve only grown shorter."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Now, there\u2019s no need for harsh words."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: It was going to happen with or without you.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "I know, it just went by so fast. It\u2019s like you were just a
        baby yesterday, and a blink and a half later, here we are."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Well, I wasn\u2019t going to stay a kid forever, you know."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    NpcReactionText:
    - Dialogue: "I know, it just went by so fast. It\u2019s like you were just a
        baby yesterday, and a blink and a half later, here we are."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: Have you considered puberty?
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "Now, there\u2019s no need for harsh words."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: When did you care how tall I was?
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Question:
    NpcReactionText:
    - Dialogue: "That\u2019s...of course I am. "
      Portrait: {fileID: 0}
    - Dialogue: "There\u2019s a lot to be afraid of, sure, but there\u2019s a whole
        lot more to be excited for, don\u2019t you think?"
      Portrait: {fileID: 0}
    - Dialogue: "What\u2019s behind us has already happened, and what\u2019s next
        is just around the corner."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: Grandma...are you afraid of getting older?
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Silent:
    NpcReactionText: []
    BranchingDialogue: {fileID: 11400000, guid: c11402c7f70323846925ef4c2eb20a4c, type: 2}
    CombinedDialogue: []
    PlayerDialogue: ...
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  End: 0
