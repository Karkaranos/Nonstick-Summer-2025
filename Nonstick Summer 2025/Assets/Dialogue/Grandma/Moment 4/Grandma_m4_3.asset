  m_Name: Grandma_m4_3
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: 'Listen, sweetie, I just wanted to tell you that I love you so very
      much. '
    Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
  - Dialogue: "I know it must feel like there\u2019s a lot going on right now at
      your age,"
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: "but I just hope you\u2019ll never be too old for your Nanna, okay?"
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m sure you will. Just you wait. Life only gets better the
        longer it goes."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    - Dialogue: Trust me.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "I\u2019d be lucky if I\u2019m as cool as you when I\u2019m older."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Just hang in there Pumpkin. Wverything will work out in the end.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    - Dialogue: Your Nanna will make sure of it!
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    CombinedDialogue: []
    PlayerDialogue: Sure.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I know she can be a bit much sometimes, but she\u2019s only wants
        the best for you."
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    - Dialogue: "She loves you with all of her heart, she just doesn\u2019t always
        show it."
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "I just hope Mom lets up a little bit. It\u2019s been really
      hard lately."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Don\u2019t worry, I\u2019ll love you even then."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: Not if I turn into a vampire and become immortal.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Well... I\u2019m sorry to hear that honey. I thought you\u2019d
        like it."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: "It doesn\u2019t matter, you\u2019ll be gone when I\u2019m older
      anyway."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "So do I, but we\u2019re spending time together now. That\u2019s
        all I could ever ask for."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: I wish we spent more time together.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: "All those things, no matter what. I\u2019ll always love my little
        pumpkin!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: Would you still love me if I was a dog? Or a snail? What about
      a puddle?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "Right, of course...don\u2019t let your old Nanna keep you up."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    - Dialogue: "You start looking, I\u2019ll be there in just a minute."
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: Yeah, I love you too. Can you help me look for my phone now?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Question:
    NpcReactionText:
    - Dialogue: "I\u2019m fine."
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    - Dialogue: "Please don\u2019t worry about your Nanna, you\u2019ve got plenty
        on your plate to worry about already with that mother of yours."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue: []
    PlayerDialogue: "Are you really sure you\u2019re doing alright?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2378fbf8c2fae8f4497d4c3014a229f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Silent:
    NpcReactionText:
    - Dialogue: "..I\u2019ll leave you to it, then."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Sad
    CombinedDialogue:
    - Dialogue: Look, honey...I know your mom can sometimes make you angry, but it
        comes from a good place.
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: If you try to talk with her, try to remember that, okay?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: And be honest with both her and yourself.
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
