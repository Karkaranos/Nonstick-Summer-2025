  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Grandma_m5_1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: There you are. Did you need help packing?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Of course! I\u2019m be more than willing to help my Pumpkin out.
        With me and you on the case nothing will be able to stop us."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
    - Dialogue: "I'm sure we can get this all unpacked before you can say, \u201CI
        love you Nanna!\u201D"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    PlayerDialogue: "Not anymore, but I\u2019ll definitely need some help unpacking
      all of this if you\u2019d be willing to help."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Wow, you guys work really fast!
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    - Dialogue: And your poor old Nanna here thought that you might not be ready
        to move out on your own.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "We\u2019re already done, you don\u2019t have to worry about
      it anymore."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "You should learn to rely on others sometimes. It\u2019s not good
        to try and do everything yourself you know."
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: We are all here for that exact reason, to help you.
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Don\u2019t worry, I got it all."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Really? In that case, you\u2019d better find a train to catch, and
        quick."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Oh, I\u2019m not packing much; just a stick with a cloth tied
      around the end."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 1
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Oh, I hadn\u2019t noticed. Sorry, dear."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: I thought the packed suitcases were obvious.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -1
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: Of course.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Don\u2019t worry, I got it all."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    NpcReactionText:
    - Dialogue: I sure hope not. Where would your Mom live?
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: What else is there to pack, the whole house?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "Oh, I hadn\u2019t noticed. Silly me, I must have missed all the
        boxes lying around."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: Sorry, dear.
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue: []
    PlayerDialogue: "We\u2019ve already taken care of it. Can\u2019t you see?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Sappy_Question:
    NpcReactionText:
    - Dialogue: Oh, alright...
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: I guess I'll just sit back then and give you guys some moral support
        from the sidelines, just like I always do...
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: The rest of us can handle this. Unless you are going to turn
      down an open invitation to sit and relax?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1aba6adb79996f9458d3d60f30b902f4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Silent:
    NpcReactionText: []
    CombinedDialogue: []
    PlayerDialogue: ...
    RelationshipCheckRequired: 0
