  dialogue:
  - Dialogue: Now, before you go, I wanted to tell you something...
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: 'Watching you grow up has been one of the greatest blessings in my
      entire life. '
    Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Sad
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "You\u2019re going to do great things out there, I just know it."
    Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Alright, no need to make this any longer than it needs to be. Wouldn't
      want to keep you, after all.
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Don't forget to visit your old Nanna, you hear?
    Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
    AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
    AudioResponse: Angry
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Goodbye, dear. I love you.
    Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
