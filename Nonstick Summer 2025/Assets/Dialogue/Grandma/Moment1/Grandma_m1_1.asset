    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Hehehe, well... I taught your Momma how to be fun, so you will love
        playing with me!
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue:
