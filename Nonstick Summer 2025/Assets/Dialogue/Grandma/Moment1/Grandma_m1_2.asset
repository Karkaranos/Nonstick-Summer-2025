  dialogue:
  - Dialogue: Are these your blocks? Do you want Nanna to help you? Maybe we could
      build a house.
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Of course sweetie, just tell me where to put stuff.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue:
    - Dialogue: Of course sweety, just tell me where to put stuff.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    - Dialogue: Are you excited for your first day of school?
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    PlayerDialogue: Sure Nanna, help your little pumpkin please!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: fd1563d01e5711f4db087ce3fd8bab65, type: 2}
