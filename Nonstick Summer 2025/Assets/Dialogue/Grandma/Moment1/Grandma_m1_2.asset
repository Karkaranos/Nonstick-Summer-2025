      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: I want to do it myself.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: fd1563d01e5711f4db087ce3fd8bab65, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m sorry pumpkin, I got a bit ahead of myself. I\u2019d love
