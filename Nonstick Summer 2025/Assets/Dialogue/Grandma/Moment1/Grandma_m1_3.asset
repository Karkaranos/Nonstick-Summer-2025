  dialogue:
  - Dialogue: Are you excited for your first day of school?
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s great pumpkin! If you are anything like your Nanna,
        I\u2019m sure you\u2019ll have a ton of fun and make loads of friends!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m super excited!! I hope to make a ton of new friends!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 05693c730dc917046b1ea64852734d1f, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t say that sweetie. Someone as sweet as you will have lots
        of friends that you\u2019ll have tons of fun with every single day! Your
        Nanna guarantees it!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: No, I never want to go to school! School is STUPID.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 05693c730dc917046b1ea64852734d1f, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
