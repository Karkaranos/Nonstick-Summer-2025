  dialogue:
  - Dialogue: Hello Pumpkin, you look like you're ready for the big game!
    Portrait: {fileID: 21300000, guid: 7869ad9eba8e60e4dab075f9d8bc6428, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s the spirit."
      Portrait: {fileID: 0}
    - Dialogue: "I know you\u2019ve put in a ton of hard work, I just wish everyone
        could see just how amazing you\u2019ve become."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "You know it! Nanna\u2019s Pumpkin is going to put on a show
      with their amazing skills!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "It\u2019s pretty obvious just looking at you, your hard work is
        really paying off."
      Portrait: {fileID: 0}
    - Dialogue: I just know you are going to be great out there with confidence like
        that.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Thank you, I\u2019ve been training really hard for this."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Come on, don\u2019t think like that, remember all the time and effort
        you put into practicing for this game."
      Portrait: {fileID: 0}
    - Dialogue: You are more than ready!
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I know you\u2019re just saying that..."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d1cb0204a0d275243bb3974fa791ac7c, type: 2}
