  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Grandma_m3_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Has your mom been treating you well?
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "You don\u2019t have to lie to me Pumpkin."
      Portrait: {fileID: 0}
    - Dialogue: "I know what happened has been hard on us all, but you don\u2019t
        need to hide it from me."
      Portrait: {fileID: 0}
    - Dialogue: Your Nanna is strong you know, she can handle it.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: You know us, right as rain just like we always are!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m sorry to hear that."
      Portrait: {fileID: 0}
    - Dialogue: I appreciate you being honest with me.
      Portrait: {fileID: 0}
    - Dialogue: Ever since your Grandpa passed, everyone has been a bit on edge.
      Portrait: {fileID: 0}
    - Dialogue: Just give your mother some time and I am sure things will go back
        to normal eventually...
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "To be honest, we\u2019ve been fighting a lot lately."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019ll talk to her to make sure she makes time for you."
      Portrait: {fileID: 0}
    - Dialogue: "I know she has two jobs, but that\u2019s no excuse not to have time
        for you."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "We haven\u2019t really had the time to spend it with each other
      recently."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "That\u2019s great to hear, I\u2019m glad everything seems to be
        smooth sailing."
      Portrait: {fileID: 0}
    - Dialogue: "I was worried that Grandpa\u2019s passing would throw everything
        for a loop."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "As always, she\u2019s the one that\u2019s making sure I\u2019m
      staying on top of my training schedule."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Sorry, you\u2019re right, I guess I was just in my head a bit."
      Portrait: {fileID: 0}
    - Dialogue: You have to be focused if you want to help win that trophy.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: 'That is an odd thing that bring up at a time like this. '
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: I was worried that might be the case...
      Portrait: {fileID: 0}
    - Dialogue: Just give your mother some time.
      Portrait: {fileID: 0}
    - Dialogue: "I know we all need time after going through something like your
        grandfather\u2019s passing."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "It\u2019s been a bit rough lately, I just hope that she isn\u2019t
      biting off more than she can chew."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Charming_Question:
    NpcReactionText:
    - Dialogue: "You don\u2019t have to walk on eggshells around me sweet pea, I\u2019d
        rather you just talk with me and be honest with me."
      Portrait: {fileID: 0}
    - Dialogue: Make some time for your Nanna okay?
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Things have never been better, what makes you bring that up though?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "I\u2019m doing fine now, thanks for asking."
      Portrait: {fileID: 0}
    - Dialogue: "I\u2019ve just been a bit out of it ever since your Grandfather
        passed."
      Portrait: {fileID: 0}
    - Dialogue: "Don\u2019t worry about me though, I\u2019m sure your super Nanna
        will be back to her usual self before you know it!"
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Are you alright Nanna?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b98f0011ea366da459066c9cc7eed3f8, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Question:
    NpcReactionText:
    - Dialogue: I was worried that might be the case...
      Portrait: {fileID: 0}
    - Dialogue: "I\u2019m doing alright, just a bit out of it lately."
      Portrait: {fileID: 0}
    - Dialogue: "I\u2019m glad I get to watch my amazing Pumpkin perform in the big
        game, hopefully it can take my mind off things for even just a moment."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Yeah, we\u2019ve been alright, just a bit busy lately. More
      importantly, how are you Nanna?"
    RelationshipCheckRequired: 0
