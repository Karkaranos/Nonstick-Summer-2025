    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: Of course you are ready.
      Portrait: {fileID: 0}
    - Dialogue: "I\u2019ll been cheering the loudest for you on the sidelines."
      Portrait: {fileID: 0}
    - Dialogue: Be sure to listen out for me when you hoist that trophy up in the
        air.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Thanks, I really don't know if I'm ready.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 481e7042a7fd02848926d60f4685b6cd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: You are darn right it will.
      Portrait: {fileID: 0}
    - Dialogue: "Just make sure you do your part and I\u2019m sure everything will
        work out!"
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Thank you! It's going to take all of us working together to bring
      the trophy home.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 481e7042a7fd02848926d60f4685b6cd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Of course it will, you\u2019ve put in too much time and effort in
