  dialogue:
  - Dialogue: Good luck out there, I'll be rooting for you!
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "No matter what I know you'll do your best. That\u2019s all that
        matters."
      Portrait: {fileID: 0}
    - Dialogue: I love you!
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: I'll be sure to put on a performance!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
