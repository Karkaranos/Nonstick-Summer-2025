--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Grandma_m5_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: "Aren\u2019t you excited? Moving into your own place for the first
      time is no small thing."
    Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s the little pumpkin that I know. Seems like you\u2019ve
        still got that youthful spirit to you just like your Nanna."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
    PlayerDialogue: "\u201CExcited\u201D might not be the right word. Let me think...
      \u201CExistential dread\u201D might be more apt."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 31a1d4d1fdbcb2b469cc6fca5cbe5769, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 81fdf8506f94941489f6a93ce882ec95, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 2094e15fc3fa10f4898e7d61cb0d12d7, type: 2}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s the spirit! Feeling nerves is a normal part of life,
        it just means that you care."
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    - Dialogue: Never back down when your nerves start to become too much, push through
        them like you always have and everything will turn out just fine!
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019d be lying if I said I wasn\u2019t nervous, but despite
      that I am ready to take on anything this new phase of my life throws at me."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 31a1d4d1fdbcb2b469cc6fca5cbe5769, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 81fdf8506f94941489f6a93ce882ec95, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 2094e15fc3fa10f4898e7d61cb0d12d7, type: 2}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: Of course you are ready Pumpkin.
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
    - Dialogue: Everything that you have gone through and you are still as bright
        as they day that I first saw you.
      Portrait: {fileID: 21300000, guid: 3c5a932a5b004e74c9feef6bca52801e, type: 3}
    - Dialogue: I promise, there is nothing that can stand in your way now.
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m a bit nervous, I\u2019m not sure that I am ready."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 31a1d4d1fdbcb2b469cc6fca5cbe5769, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 81fdf8506f94941489f6a93ce882ec95, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 2094e15fc3fa10f4898e7d61cb0d12d7, type: 2}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "See? That\u2019s the spirit!"
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Yeah! I can\u2019t wait for all the vacuuming and laundry and
      dirty dishes..."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: dd65eb34f68b6064fb04796cddf996c4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "I\u2019m sure she\u2019s worried for you. Believe me, it can be
        a lot on a parent when their kid moves out."
      Portrait: {fileID: 0}
    - Dialogue: "You never know how empty a house can feel until you\u2019re the
        only one living in it."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "We weren\u2019t expecting you to visit."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: dd65eb34f68b6064fb04796cddf996c4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "That\u2019s called growing up. Our childhoods might make us who
        we are now..."
      Portrait: {fileID: 0}
    - Dialogue: "But that doesn\u2019t mean we\u2019re ever done growing. Remember
        that."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I don\u2019t feel like I\u2019m ready. It\u2019s like I was
      only a kid four days ago."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: dd65eb34f68b6064fb04796cddf996c4, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: "Trust me, better to have what you don\u2019t need than need what
        you don\u2019t have. Better safe than sorry!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "We\u2019ve got enough boxes to build a huge castle like we used
      to. Are you sure we need this many?"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 31a1d4d1fdbcb2b469cc6fca5cbe5769, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 81fdf8506f94941489f6a93ce882ec95, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 2094e15fc3fa10f4898e7d61cb0d12d7, type: 2}
    ChangeInRelationshipStatus: 10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "Aww, please don\u2019t look at it like that. It\u2019s what you
        make of it that matters."
      Portrait: {fileID: 21300000, guid: ac419e742a52675469ffd17ad86add74, type: 3}
    CombinedDialogue: []
    PlayerDialogue: I know Mom is probably the excited one now that I am moving out
      of the house right?
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 31a1d4d1fdbcb2b469cc6fca5cbe5769, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 81fdf8506f94941489f6a93ce882ec95, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 2094e15fc3fa10f4898e7d61cb0d12d7, type: 2}
    ChangeInRelationshipStatus: -5
  Sappy_Question:
    NpcReactionText:
    - Dialogue: "You know you can\u2019t do that pumpkin."
      Portrait: {fileID: 21300000, guid: 3be242fd8c69cb04ea12ee80ec7a0339, type: 3}
    - Dialogue: "You\u2019ll always be my little sunshine, but you have to go out
        on your own and show the rest of the world just how amazing you are!"
      Portrait: {fileID: 21300000, guid: 3571cedc5744cb747aef6a7c6bc67ac6, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m not ready Nanna, can\u2019t I just stay with you?"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 31a1d4d1fdbcb2b469cc6fca5cbe5769, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 81fdf8506f94941489f6a93ce882ec95, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 2094e15fc3fa10f4898e7d61cb0d12d7, type: 2}
    ChangeInRelationshipStatus: -15
  Silent:
    NpcReactionText: []
