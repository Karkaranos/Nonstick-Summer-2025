  dialogue:
  - Dialogue: There you are! Did you clean up all your toys?
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Is that so? I\u2019ll believe it when I see it."
