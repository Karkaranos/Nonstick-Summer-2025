    BranchingDialogue: {fileID: 11400000, guid: a209ae90deb3d9947b756e4a4d7519c4, type: 2}
    CombinedDialogue: []
    PlayerDialogue: I did, and really fast too!
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Thank you dear.
