    ChangeInRelationshipStatus: 10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: Because I said so.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8e3d5ccbf08c4a843a37ca4236ea51f5, type: 2}
    CombinedDialogue: []
    PlayerDialogue: Why should I behave?
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 11400000, guid: 5b121f534c74f534288df6ebe03df590, type: 2}
    ChangeInRelationshipStatus: -10
  Sappy_Question:
    NpcReactionText:
    - Dialogue: "Well, sometimes Grandma can\u2019t make the drive by herself, and
        sometimes we can\u2019t either."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: 8e3d5ccbf08c4a843a37ca4236ea51f5, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Why doesn\u2019t she visit more?"
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 11400000, guid: 5b121f534c74f534288df6ebe03df590, type: 2}
    ChangeInRelationshipStatus: 10
