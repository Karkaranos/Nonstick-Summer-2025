    BranchingDialogueLow: {fileID: 11400000, guid: 5b121f534c74f534288df6ebe03df590, type: 2}
    ChangeInRelationshipStatus: 10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t say that...we can go out for pizza, your favorite!"
