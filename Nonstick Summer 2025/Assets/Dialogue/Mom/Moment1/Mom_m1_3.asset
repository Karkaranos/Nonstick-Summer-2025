  dialogue:
  - Dialogue: "Have you thought about what you want for your birthday yet? It\u2019ll
      be here before you know it."
    Portrait: {fileID: 21300000, guid: c2360f7827c4e38498ba0e512f1c8260, type: 3}
  - Dialogue: "If you\u2019re good for Grandma tonight, then she might remember that
      when she\u2019s out shopping for your present..."
    Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m glad your appreciate her gifts. She appreciates getting
        to spend time with you."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    CombinedDialogue: []
    PlayerDialogue: Grandma always gets me the best gifts!
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 35}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8e3d5ccbf08c4a843a37ca4236ea51f5, type: 2}
