  dialogue:
  - Dialogue: "Have you thought about what you want for your birthday yet? It\u2019ll
      be here before you know it."
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: "If you\u2019re good for Grandma tonight, then she might remember that
      when she\u2019s out shopping for your present..."
    Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Happy
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m glad. She appreciates getting to spend time with you."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: Grandma always gets me the best gifts!
