  dialogue:
  - Dialogue: Now, are you ready for your first day of school tomorrow? You've got
      a big day ahead of you.
    Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Happy
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Today is an opportunity to make new friends to play with this summer.
        It\u2019s exciting!"
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: I thought I got to skip to summer break.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 4b65f41e5261340488d85ab47e2f1fe6, type: 2}
