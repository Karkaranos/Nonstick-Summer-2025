  dialogue:
  - Dialogue: '...Listen, I know moving to a new place can be scary, but it can be
      just as exciting. '
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
  - Dialogue: We just need to make the most of it, okay? Can you do that for me?
    Portrait: {fileID: 21300000, guid: 032b2ac25e695414a96b9f1f4f473521, type: 3}
    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m so proud of you, honey, but it\u2019s okay to be scared."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m not scared!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b4dae051c3aa5b14f983515b2f09466c, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: ...Me too.
      Portrait: {fileID: 21300000, guid: 032b2ac25e695414a96b9f1f4f473521, type: 3}
      AnimatedReaction: {fileID: 0}
    - Dialogue: "But we\u2019re here now."
