  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Happy birthday, Sweetie! Have you had fun today?
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m glad you like them, honey."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: I got so many gifts! And one of them is giant!!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Yeah, because any old day, we throw a party and have the family come
        over? ... Yeah.
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Angry
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "It was fine. It\u2019s just a birthday. Like any other old day."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I know, but the drive is just too much for him, honey. We can ask
        grandma to call him with us in a bit, I\u2019m sure he\u2019d like that."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "It\u2019s been so nice, I just wish Grandpa could\u2019ve come."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: "I know you\u2019re excited. There\u2019s one more in the mail. I
        need you to be patient for me though. Play with the ones you have!"
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
      AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
      AudioResponse: Angry
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "It\u2019s been fun... but am I going to get everything from
      my wishlist..?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "I\u2019m glad you\u2019re excited to play with your toys, but be
        nice to your family, okay?"
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Angry
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: They came all this way for you!
