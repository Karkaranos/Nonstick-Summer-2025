  dialogue:
  - Dialogue: Happy Birthday, sweetie!
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  - Dialogue: Have you had fun today?
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  Charming_Expression:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: HEHEH! Birthday gifts!!!!
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: Yeah. But I wish I could be playing with my presents instead
      of Uncle and Cousin being over.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Expression:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: Thanks mom.. You really helped make it special today for me.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: I got 7 gifts!! And one of them is giant!!
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Observation:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: "It was fine. It\u2019s just a birthday.  Like any other old
      day."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: "It\u2019s been so nice, even if Grandpa couldn\u2019t come."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: "It\u2019s been super fun! Are there more presents for meee?"
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Question:
    BranchingDialogue: {fileID: 11400000, guid: d7918fcd4bc6f7741a6b8c47ac85eff1, type: 2}
    PlayerDialogue: When is everyone going to leave already?
