  dialogue:
  - Dialogue: 8 whole years! Where did the time go?
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  - Dialogue: Do you feel all grown up?
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t worry, you\u2019ve got many more years. More than enough
        time to have more favorite shirts."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Sorta... my favorite shirt doesn\u2019t fit anymore."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
