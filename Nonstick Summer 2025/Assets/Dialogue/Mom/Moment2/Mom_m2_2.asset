  dialogue:
  - Dialogue: 8 whole years! Where did the time go?
    Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  - Dialogue: Do you feel all grown up?
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: 
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t worry, you\u2019ve got many more years. More than enough
        time to have more favorite shirts."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Sorta... my favorite shirt doesn\u2019t fit anymore."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 9bc506d4cf1c8734c91dec3a11bce56f, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Well, you\u2019re a year older from last year. Maybe you\u2019ve
        learned some lessons since then."
      Portrait: {fileID: 21300000, guid: 032b2ac25e695414a96b9f1f4f473521, type: 3}
