    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "It\u2019s not always about gifts! Your uncle drove him him here
        to spend time with you on your birthday. You can at least be thankful for
        that."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "\u201CLittle Cousin didn't even get me a gift. I don\u2019t
      want to thank him."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
