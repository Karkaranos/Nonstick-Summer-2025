  dialogue:
  - Dialogue: Now, now. Go have some fun, and make sure to tell everyone thank you.
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "I\u2019m sure he\u2019ll appreciate that. He loves playing with
        you."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019ll thank Little Cousin by going easy on him the next
      time we play cards"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Just don\u2019t forget to. They came all this way and gave gifts
        to you for your birthday."
      Portrait: {fileID: 21300000, guid: 032b2ac25e695414a96b9f1f4f473521, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019ll thank them when they leave."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
