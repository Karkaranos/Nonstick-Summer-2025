    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: Thank you, dear. Your grandma worked hard on it for you.
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019ll be sure to thank everyone! Plus I have to thank Nanna
      for the cake!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Yes, good. Don\u2019t get into too much trouble while you do."
