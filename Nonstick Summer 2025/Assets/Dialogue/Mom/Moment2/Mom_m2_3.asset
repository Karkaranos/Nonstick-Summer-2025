  dialogue:
  - Dialogue: Now, now. Go have some fun, and make sure to tell everyone thank you.
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: You should be thanking them. They came all this way and gave gifts
        to you for your birthday.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019ll tell them thank you... thank you for nothing, haha!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
