    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: ".... Me too. It\u2019s okay, honey. We can call him on the phone
        later. I\u2019m sure he would have come if he was feeling better."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: I wish I could thank grandpa.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Yes, good. Don\u2019t get into too much trouble while you do."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019ll be sure to thank everyone!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 7978eb1968e47ff44aabaf8739c0be06, type: 2}
