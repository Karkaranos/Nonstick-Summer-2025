  dialogue:
  - Dialogue: Hello? Have you left for the game yet?
    Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Haha.
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m sorry, your call has been declined. Please leave your
      message at the beep. Beeeep."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: bfbf295814978d742af67627b5083931, type: 2}
