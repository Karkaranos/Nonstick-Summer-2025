      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: Sorry honey, I have to go.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: Call me when you get back, okay?
