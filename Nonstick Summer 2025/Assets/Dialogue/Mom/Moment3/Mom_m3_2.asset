    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: ...
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: "Look, I\u2019ve already tried to talk my supervisor into letting
        me drive over during my lunch break, but it\u2019s too far of a drive."
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Sad
    - Dialogue: "I\u2019ll make it up to you, I promise."
