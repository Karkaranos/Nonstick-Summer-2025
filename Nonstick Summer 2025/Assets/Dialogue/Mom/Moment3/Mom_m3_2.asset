  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Did you pack enough water?
    Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
  - Dialogue: Sunscreen?
    Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: "I\u2019m sure Grandma can help you put together some snacks."
    Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Good thing your Grandma made her famous granola balls for the team!
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    - Dialogue: "She\u2019d never let you go hungry."
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "Grandma ate everything! I guess we\u2019ll to have to buy more
      of the good snacks."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8cb10061bd303d442bc4c7567918db15, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Well, you\u2019re still MY kid."
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    - Dialogue: Mind the attitude.
      Portrait: {fileID: 21300000, guid: 985b9ad40b91e70409344b1e812bfabc, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m not a kid anymore. I can pack my own snacks."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8cb10061bd303d442bc4c7567918db15, type: 2}
