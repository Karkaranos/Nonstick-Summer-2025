  dialogue:
  - Dialogue: "Did you pack enough water? Sunscreen? I\u2019m sure Grandma can help
      you put together some snacks."
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t call them gross! Your Grandma puts a lot of hard work
        into making those for you kids."
      Portrait: {fileID: 0}
    - Dialogue: "Although It wouldn\u2019t kill her to put in a little sugar too..."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: No need, she already made those gross granola balls for the team.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8cb10061bd303d442bc4c7567918db15, type: 2}
