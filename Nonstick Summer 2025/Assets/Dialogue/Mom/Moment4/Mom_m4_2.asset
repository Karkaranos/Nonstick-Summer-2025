  dialogue:
  - Dialogue: Does the idea of being grounded mean nothing to you?
    Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t be smart with me."
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
    CombinedDialogue: []
    PlayerDialogue: Ah yes... no fun, no phone, no time in the sunlight, wither away
      in remorse in my room. Grounded. Yeah, I get it.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8d843fbd71fa1514b89fdc17c7d0174b, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Don\u2019t be smart with me."
      Portrait: {fileID: 21300000, guid: c2360f7827c4e38498ba0e512f1c8260, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "You don\u2019t understand! This doesn\u2019t mean I was going
      to take my phone and use it full-time again."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 8d843fbd71fa1514b89fdc17c7d0174b, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Sappy_Expression:
