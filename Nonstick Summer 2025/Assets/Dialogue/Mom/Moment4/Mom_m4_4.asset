    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "Like what? Because I\u2019m tired of you thinking you can walk all
        over me."
      Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "Can\u2019t we talk about this? There has to be something else
