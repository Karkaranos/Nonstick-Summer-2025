      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "At least my PHONE doesn\u2019t hate me!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb155b1ce45f98b498db67f5ca5d0578, type: 2}
