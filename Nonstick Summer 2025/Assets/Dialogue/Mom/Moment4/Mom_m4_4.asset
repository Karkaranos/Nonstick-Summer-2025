    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "Is it MY fault that you didn\u2019t study?! Is it MY fault that
        you\u2019ve been clothed and fed with a roof over your head?"
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "No one asked you to do that! And it\u2019s not even my fault!"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
