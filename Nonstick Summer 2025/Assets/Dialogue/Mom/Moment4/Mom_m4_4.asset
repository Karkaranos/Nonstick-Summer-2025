  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: I work day and night for this family, but all I ever see you care about
      is your phone!
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
  - Dialogue: You are grounded, do you understand that?!
    Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Is that really what you think of me? Do you think I\u2019m doing
        this because I HATE YOU?"
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
    - Dialogue: " I don\u2019t want to be the bad guy,"
      Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    - Dialogue: "but you\u2019re forcing my hand!"
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
    CombinedDialogue: []
    PlayerDialogue: At least my PHONE listens to me!
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb155b1ce45f98b498db67f5ca5d0578, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 35a765a981612e641a15e6244d33e73a, type: 2}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Are you sure? Because you\u2019re not making a good case for yourself
        by sneaking behind my back like this."
      Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m not trying to sound ungrateful. I AM grateful but you\u2019re
      being UNFAIR right now!"
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb155b1ce45f98b498db67f5ca5d0578, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: 35a765a981612e641a15e6244d33e73a, type: 2}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "I don\u2019t HAVE to take care of you, but a little RESPECT shouldn\u2019t
        be too much to ask for either."
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
    CombinedDialogue:
    - Dialogue: "I don\u2019t HAVE to take care of you, but a little RESPECT shouldn\u2019t
        be too much to ask for either."
      Portrait: {fileID: 0}
    - Dialogue: Go to your room!
      Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
    - Dialogue: NOW!
      Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
    PlayerDialogue: " A tragedy. It\u2019s almost like you\u2019re A MOTHER who is
      supposed to CARE ABOUT HER KID."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 0, y: 30}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb155b1ce45f98b498db67f5ca5d0578, type: 2}
