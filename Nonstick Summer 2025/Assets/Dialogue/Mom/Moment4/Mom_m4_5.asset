--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Mom_m4_5
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: "Do you not think I\u2019m doing everything in my power to give you
      a good childhood? To show you how much I care about you as a mom?"
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  - Dialogue: I could stay home every single day sat on that couch, not bothering
      to lift a finger to cook dinner, drive you to school, pay for your phone...
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  - Dialogue: Do you know how EASY that would be for me?
    Portrait: {fileID: 21300000, guid: 57210594b1b36fc47907edd57852b79c, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Oh, that is IT.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "With how much you work, I doubt you\u2019d be able to sit still
      for long."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Oh, that is IT.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "If you ask me, I\u2019d say you\u2019re making it pretty hard
      to tell you care at all."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "No, it\u2019s just..."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "I...I had no idea you felt like that. I\u2019m sorry."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: Oh, that is IT.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "As easy as it would be to let me have my phone back, I\u2019d
      imagine."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: "You\u2019re still MY kid, aren\u2019t you?"
      Portrait: {fileID: 0}
    - Dialogue: "Even if you leave this house hating me, I\u2019m STILL going to
        be your mother and I\u2019m STILL going to love you."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "It was fine. IWell, I\u2019m not a CHILD anymore!\u2019s just
      a birthday.  Like any other old day."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "You shouldn\u2019t HAVE to."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "No, I...haven\u2019t really considered that before."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    NpcReactionText:
    - Dialogue: Oh, that is IT.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Wouldn\u2019t that be the life, huh?"
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "You\u2019re still MY kid, aren\u2019t you?"
      Portrait: {fileID: 0}
    - Dialogue: "Even if you leave this house hating me, I\u2019m STILL going to
        be your mother and I\u2019m STILL going to love you."
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: "Then why don\u2019t you do it?"
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Question:
    NpcReactionText:
    - Dialogue: ..Well, to start, you can leave your phone where you found it.
      Portrait: {fileID: 0}
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: What can I do to show that I care? Because I do.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Silent:
    NpcReactionText: []
    BranchingDialogue: {fileID: 11400000, guid: b19c8c28d10698b41a5822b790eeb36d, type: 2}
    CombinedDialogue: []
    PlayerDialogue: ...
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  End: 0
