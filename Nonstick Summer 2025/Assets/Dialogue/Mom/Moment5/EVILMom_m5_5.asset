  dialogue:
  - Dialogue: "You need to head out soon if you\u2019re going to get there before
      dark. I\u2019ll help you pack the car."
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Just...
    Portrait: {fileID: 21300000, guid: 032b2ac25e695414a96b9f1f4f473521, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "Remember to call home every once and a while once you\u2019re out
      there."
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: ...Okay?
    Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: I love you, kid.
    Portrait: {fileID: 21300000, guid: 032b2ac25e695414a96b9f1f4f473521, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Sad
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "See? That\u2019s the spirit!"
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    PlayerDialogue: "I definitely wouldn\u2019t call it \u201Cexcited\u201D. More
      like \u201Cexistentially apprehensive\u201D."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: dd65eb34f68b6064fb04796cddf996c4, type: 2}
