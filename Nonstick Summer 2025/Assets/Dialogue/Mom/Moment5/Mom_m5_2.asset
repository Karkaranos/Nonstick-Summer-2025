  dialogue:
  - Dialogue: How can I help you?
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Well since you asked so nicely, I\u2019ll call off the construction
        guys."
      Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    - Dialogue: "You\u2019ll always have a place here."
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
    PlayerDialogue: "Don\u2019t turn my room into a gym while I\u2019m gone."
    RelationshipCheckRequired: 1
    RelationshipRange: {x: 35, y: 75}
    BranchingDialogueHigh: {fileID: 11400000, guid: 2b9f59df324641d42801382d059d2e46, type: 2}
    BranchingDialogueNeutral: {fileID: 11400000, guid: ba4e12e3f014fe744a00cbda084a20a1, type: 2}
    BranchingDialogueLow: {fileID: 11400000, guid: 9811cb0413a18314eb9cef281291266b, type: 2}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Make sure you fold it 3 times so you can really pack the box.
