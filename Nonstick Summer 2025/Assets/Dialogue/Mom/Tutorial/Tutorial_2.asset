    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Haha, you\u2019ll get the hang of it, I promise."
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue:
    - Dialogue: "Haha, you\u2019ll get the hang of it, I promise."
      Portrait: {fileID: 21300000, guid: 24794c9372059fe4c811fbd57b999120, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    - Dialogue: "Now, it\u2019s important for you to keep your [Social Battery] in
        mind as you talk to everyone."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
      HasAdvancedSignal: 1
      AdvancedSignal: 1
    - Dialogue: 'Your [Social Battery] carries over to your conversation and is what
        allows you to play cards.  '
      Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
      HasAdvancedSignal: 1
      AdvancedSignal: 1
    - Dialogue: Different cards have different [Social Battery] costs, depending
        on your [Personality] or the [Stamps] you put on your card.
      Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
      HasAdvancedSignal: 1
      AdvancedSignal: 1
    PlayerDialogue: This is sounding like a lot to remember...
