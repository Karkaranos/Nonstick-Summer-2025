  m_Name: Tutorial_2
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: 'Allow me to explain this whole thing a little more... In a few moments,
      your life is about to begin! '
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "As you talk with your family, you\u2019ll have the option of playing
      different types of cards, with each card having a unique \u201Cdialogue\u201D
      option."
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "All dialogue cards have both a [Tone(tone)] ([Witty], [Sappy], or
      [Defensive]), and an [Intent(intention)] ([Statement] or [Question]). \nPeople
      react differently based on their personalities or situations."
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "You\u2019ll be able to try it out soon!"
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Whoah, I can't wait to try this out!
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b7b869429a499444c9b40b2815eee6c8, type: 2}
