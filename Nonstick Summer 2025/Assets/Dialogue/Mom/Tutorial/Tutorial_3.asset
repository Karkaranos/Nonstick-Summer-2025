  dialogue:
  - Dialogue: "Now, it\u2019s important for you to keep your SOCIAL BATTERY in mind
      as you talk to everyone."
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: 'Your SOCIAL BATTERY carries over to your conversation and is what
      allows you to play cards.  '
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: Different cards have different SOCIAL BATTERY costs, depending on your
      PERSONALITY or the STAMPS you put on your card.
    Portrait: {fileID: 21300000, guid: 69bff71eeb1dc104a8e5e86b81320fe1, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Right? Glad you think so!
      Portrait: {fileID: 21300000, guid: 50bb4058fcfd0a848aee129378173f17, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "Oooo, \u201CSocial Battery\u201D sounds all fancy..."
