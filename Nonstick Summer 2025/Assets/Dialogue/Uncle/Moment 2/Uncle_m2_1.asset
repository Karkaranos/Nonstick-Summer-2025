  dialogue:
  - Dialogue: "There\u2019s the kid of the hour!"
    Portrait: {fileID: 21300000, guid: 599283ca56aa9da4f85f3d7e2e07d0a4, type: 3}
  - Dialogue: Has this been the best birthday ever?
    Portrait: {fileID: 0}
  Charming_Expression:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: "You know it!! I can\u2019t wait to use these card to defeat
      all of my friends!"
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Expression:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: "I don\u2019t know.... I haven\u2019t opened up all my presents
      yet."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: "Yeah, I\u2019m glad we got to spend time together as a family."
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: "Yeah! I can\u2019t believe you got me that card set! It must
      have cost a fortune! "
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Observation:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: Well... It would be better if you had gotten me the right card
      set.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Sappy_Observation:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: Yeah. I just wish Grandpa could be here. Mom said he is too sick.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Question:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: Of course, these cards that you got me are the real deal! How
      in the world did you get these!?
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Question:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: Almost perfect... If only you could tell me what grandma gifted
      me? I know you saw her wrap it.
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Question:
    BranchingDialogue: {fileID: 11400000, guid: db646a170bec0244b8ff60a54ef21847, type: 2}
    PlayerDialogue: Of course!!! It was the best ever. What were your birthdays like
      when you were my age, Uncle?
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Silent:
    BranchingDialogue: {fileID: 11400000}
    PlayerDialogue: ...
    RelationshipRequirement: 0
    AlternateBranch: {fileID: 0}
    ChangeInRelationshipStatus: -5
  End: 0
