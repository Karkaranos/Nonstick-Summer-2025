  dialogue:
  - Dialogue: "You know, I\u2019ve been getting pretty good at that new shooter game
      that came out."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
  - Dialogue: Maybe we could play it sometime?
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That won\u2019t be an issue. I\u2019ll make sure to ask her to bump
        it up to at least two this time."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "Really? I hope Mama let\u2019s me play longer this time."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b8e3d37aeac500a49895cfc1fbf6cf2e, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s what I like to hear. Looks like I\u2019ll have to step
        it up as well."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I don\u2019t know...you might have to get better if I\u2019m
      gonna play with you. I beat you last time."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b8e3d37aeac500a49895cfc1fbf6cf2e, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Come on, where's the excitement from last time? Don\u2019t worry
        about how well you do, just have fun!"
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "That sounds great, but I\u2019ve been really busy with school,
      so I haven\u2019t had much time to play. Hopefully I won\u2019t hold you back
      too much."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: b8e3d37aeac500a49895cfc1fbf6cf2e, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "That won\u2019t be an issue, I\u2019ll be sure to convince her to
