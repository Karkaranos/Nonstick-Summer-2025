  m_Script: {fileID: 11500000, guid: 1ee689b52b074234399a9d86f8ee0df8, type: 3}
  m_Name: Uncle_m2_3
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: 'Say, did you mom tell you about those alien sightings? '
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 3507591934488137797, guid: 922dd2319f94b6b4f914e49feebe6d43, type: 3}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: "I\u2019ve been keeping an eye on the news. Apparently, a UFO was spotting
      flying towards town..."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  - Dialogue: Could be the real deal this time.
    Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Angry
    HasAdvancedSignal: 0
    AdvancedSignal: 0
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That\u2019s not that funny, you know. If they DO get abducted, who
        knows how long it\u2019ll be until they get brought back?"
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Angry
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Yeah, my friends wanna try to get our teacher abducted so class
      gets canceled.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "To be fair, they\u2019re some real crazies out there nowadays. That\u2019s
        why you gotta stay informed, y\u2019know?"
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "I can\u2019t understand how people actually fall for that stuff.
      Momma says it\u2019s all made up."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "Eh, don\u2019t read too much into it. Could be another hoax, for
        all we know.  Either way, it doesn\u2019t hurt to be too careful nowadays."
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Angry
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "I don\u2019t want aliens to get me..."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "That\u2019s awesome, you guys must be really close. You guys will
        definitely make it to the other side if it all hits the fan."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Yeah, my friends and I have been preparing the fort in the back
      with food and defenses.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: Oh yeah, real crazy people nowadays. They might even be scarier than
        the aliens they talk about all the time.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "I saw some parts of it, I can\u2019t understand how people actually
      believe in all that stuff."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -10
  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "Oh that\u2019s alright, just thought it might have been something
        you and your friends might have been talking about."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: "I haven\u2019t really had the time to watch the news, been way
      to busy with school."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    NpcReactionText:
    - Dialogue: "Eh, don\u2019t read too much into it; could be another hoax, for
        all we know.  Either way, it doesn\u2019t hurt to be too careful nowadays."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Are you sure? You said the same thing about ghosts.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Question:
    NpcReactionText:
    - Dialogue: "\u2018Course I do. Even got my basement packed with enough food
        to last a decade when the worst of it comes. Always pays to be prepared."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
      HasAdvancedSignal: 0
      AdvancedSignal: 0
    CombinedDialogue: []
    PlayerDialogue: Do you really believe all that stuff?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: cd8144ceafb8c9d4f95961ab12e9d3e5, type: 2}
