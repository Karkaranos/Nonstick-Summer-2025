    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "Hey now, you know she wants to be there, but her boss wouldn\u2019t
        let her take work off."
      Portrait: {fileID: 0}
    - Dialogue: The rest of us will be there cheering you on.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Thanks for reminding me my mom isn\u2019t coming."
