  dialogue:
  - Dialogue: "There\u2019s our all star player! I\u2019m going to cheer loud enough
      for me and your mom."
    Portrait: {fileID: 21300000, guid: 5b80e3e4b9e4ae24282ce0ed426c2aaa, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "We\u2019re just going to have to cheer your way to victory."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Don\u2019t be too loud, I have to hear my coach."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 178831001abe8eb438cd4e68f2e81625, type: 2}
