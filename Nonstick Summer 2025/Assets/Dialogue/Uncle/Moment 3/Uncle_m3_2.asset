  Assertive_Observation:
    NpcReactionText:
    - Dialogue: Well your mom was the best soccer player on the playground. But she
        never went for the school team.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: I on the other hand, kicked my ball over the fence and big foot stole
