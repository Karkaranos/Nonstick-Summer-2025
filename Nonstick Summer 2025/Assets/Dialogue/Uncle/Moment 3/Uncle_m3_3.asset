  Sappy_Observation:
    NpcReactionText:
    - Dialogue: Dad and your mom used to go to all the school games when we were
        in high school.
      Portrait: {fileID: 0}
    - Dialogue: With grandpa gone,
      Portrait: {fileID: 0}
    - Dialogue: "I\u2019m sure she\u2019d love share soccer with you."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I\u2019d like that."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: bb16b3a9546c37947818a47e3ad0ab29, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: She enjoys watching it more these days, but when I was a kid, she
        could definitely give me a run for my money.
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    - Dialogue: Quite the trash talker too.
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    CombinedDialogue: []
    PlayerDialogue: Did Nanna play soccer?
    RelationshipCheckRequired: 0
