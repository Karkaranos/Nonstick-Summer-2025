  dialogue:
  - Dialogue: Mom and Dad used to play soccer with us in the backyard.
    Portrait: {fileID: 0}
  - Dialogue: "I\u2019m sure if you asked your mom she\u2019d play with you."
    Portrait: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: Dad and your mom used to go to all the school games when we were
        in high school.
      Portrait: {fileID: 0}
    - Dialogue: With grandpa gone,
      Portrait: {fileID: 0}
    - Dialogue: "I\u2019m sure she\u2019d love share soccer with you."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Soccer really is the whole family\u2019s sport."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: bb16b3a9546c37947818a47e3ad0ab29, type: 2}
