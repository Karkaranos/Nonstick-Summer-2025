  dialogue:
  - Dialogue: "You know, I\u2019m sure if you asked your mom, she\u2019d love to
      play with you!"
    Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
  - Dialogue: "Call it practice, but I\u2019m sure she\u2019s itching to score a
      goal after all these years."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "You\u2019re pretty good, but my money is still on your mom."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "So you\u2019re saying if I beat her, I\u2019m officially the
      best player in the family."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: bb16b3a9546c37947818a47e3ad0ab29, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: Your mom is trying her best.
      Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
    - Dialogue: "I think she\u2019d much rather be playing with you than at work."
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    CombinedDialogue:
    - Dialogue: Your mom is trying her best.
      Portrait: {fileID: 0}
    - Dialogue: "I think she\u2019d much rather be playing with you than at work."
      Portrait: {fileID: 0}
    - Dialogue: "Look, I know you wish Mom could be here, but please don\u2019t take
        it out on your grandma. We need to be there for her right now, so don\u2019t
        be defensive with her. "
      Portrait: {fileID: 0}
    - Dialogue: "She\u2019s so proud of you. Your mom too."
      Portrait: {fileID: 0}
    PlayerDialogue: "She\u2019s too busy to help me practice."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: bb16b3a9546c37947818a47e3ad0ab29, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: ...He loved watching you play, kiddo.
      Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
    - Dialogue: "I\u2019m sure he would\u2019ve loved to play with you."
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    CombinedDialogue: []
    PlayerDialogue: "I wish I could\u2019ve played with Grandpa."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
