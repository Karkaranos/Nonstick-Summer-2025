  dialogue:
  - Dialogue: "...Look, I know you wish Mom could be here, but please don\u2019t
      take it out on Grandma."
    Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Sad
  - Dialogue: We need to really be there for her right now, so save the jokes for
      another time, yeah?
    Portrait: {fileID: 0}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  - Dialogue: "She\u2019s proud of you. Your mom too."
    Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Happy
