  dialogue:
  - Dialogue: "Whoa, kiddo! Didn\u2019t expect to see you today."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 0}
  - Dialogue: How have you been?
    Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "You really did, huh? You\u2019ve gotta start paying attention to
        the world around you."
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
      AnimatedReaction: {fileID: 0}
    - Dialogue: Get your nose out of that phone before it gets stuck there.
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Decent. I forgot that there was a gathering today...
