  dialogue:
  - Dialogue: "Uh, listen. I\u2019ve been meaning to check in with you for awhile,
      actually..."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
  - Dialogue: "It\u2019s just...I\u2019m worried about you."
    Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
  - Dialogue: "I\u2019m worried about the sort of things you might be getting into
      without us checking up on you."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
  - Dialogue: "It\u2019s a crazy world out there, you know?"
    Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Ha! You haven\u2019t seen the sorts of things that I\u2019ve seen,
