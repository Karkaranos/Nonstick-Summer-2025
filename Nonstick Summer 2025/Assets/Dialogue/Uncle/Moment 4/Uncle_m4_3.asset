    ChangeInRelationshipStatus: 15
  Charming_Question:
    NpcReactionText:
    - Dialogue: "First off, the end of the world wouldn\u2019t benefit anyone, so
        it\u2019s more likely to be some form of clandestine government--"
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    - Dialogue: ...Nevermind.
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Can you give me the whole \u201Cthe end is near\u201D speech
      later? I have things to do."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Assertive_Question:
    NpcReactionText:
    - Dialogue: What, am I not allowed to check in with you anymore?
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    - Dialogue: Just...be careful out there.
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Neutral
    CombinedDialogue: []
    PlayerDialogue: "You really don\u2019t have anything better to do, do you?"
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Sappy_Question:
    NpcReactionText:
    - Dialogue: "It doesn\u2019t matter what\u2019s \u201Cgood\u201D for me or not.
        It\u2019s about the truth."
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    CombinedDialogue: []
    PlayerDialogue: "Look, are you sure all this \u201Cresearch\u201D is good for
