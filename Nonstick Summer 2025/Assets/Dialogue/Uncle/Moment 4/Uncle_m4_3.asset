  m_Name: Uncle_m4_3
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: "Just... your mother\u2019s worried about you."
    Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
    AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
    AudioResponse: Sad
  - Dialogue: "We\u2019re all worried about you!"
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
    AudioResponse: Neutral
  - Dialogue: "I\u2019ve been doing a lot more reading. Research."
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Neutral
  - Dialogue: "I don\u2019t want to get into specifics now, but if your friends ever
      do or say anything that doesn\u2019t add up..."
    Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
    AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
    AudioResponse: Angry
  - Dialogue: You can tell me.
    Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
    AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
    AudioResponse: Happy
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "That wasn\u2019t what I was thinking of, but if you\u2019re sure..."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: "If you think my friends are government spies, they\u2019re not."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "This goes beyond you or me! It\u2019s deeper than that!"
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    - Dialogue: "So pardon me for making sure you\u2019re not getting swept up in
        it."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "I know you\u2019re only bugging me because you\u2019re bored."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "This goes beyond you or me! It\u2019s deeper than that!"
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    - Dialogue: "So pardon me for making sure you\u2019re not getting swept up in
        it."
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Angry
    CombinedDialogue: []
    PlayerDialogue: "If you want, we can probably hang out with you later, if you\u2019re
      lonely."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Okay! Of course. I\u2019ll be here."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 1732592836512686072, guid: ef44ce4f2cc40dd43933e177fba7a7ef, type: 3}
      AudioResponse: Happy
    CombinedDialogue: []
    PlayerDialogue: I appreciate the concern. Seriously. We can talk later.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: What, am I not allowed to check in with you anymore? Whatever, kid...
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Angry
    CombinedDialogue: []
    PlayerDialogue: "Come on. I know you\u2019re only bugging me because you\u2019re
      bored."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: eb9b3756df137fd4eb3a315c1643decd, type: 2}
