  dialogue:
  - Dialogue: Hey, I know it's not my place to say, but...
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 0}
  - Dialogue: Have you talked with your mom today? She seems pretty upset.
    Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
    AnimatedReaction: {fileID: 0}
  - Dialogue: My advice? Don't add more fuel to the fire, but be honest with her.
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 0}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Fantastic! That\u2019s good to hear. You haven\u2019t been looking
        too good lately, y\u2019know?"
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Good! I\u2019ve, uh, been good."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 0}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: "C\u2019mon. Don\u2019t be like that. I just wanna be in your life,
        alright?"
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Not now.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 0}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: Me too kiddo, once my Dad gets better we can spend time all together
        again just like the good old days.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Yeah, I\u2019m glad we got to spend time together as a family."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 0}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 15
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "You don\u2019t have to worry about that kiddo, seeing you smile
        is all that matters to me."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "Yeah! I can\u2019t believe you got me that card set! It must
      have cost a fortune! "
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 0}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Assertive_Observation:
    NpcReactionText:
    - Dialogue: Oops, sorry about that kiddo. I even asked my Son about which cards
        to get you.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: Well... It would be better if you had gotten me the right card
