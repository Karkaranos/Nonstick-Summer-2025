  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Really? In that case, you\u2019d better find a train to catch, and
        quick."
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: "I meant to pack the whole house, but didn\u2019t have time."
