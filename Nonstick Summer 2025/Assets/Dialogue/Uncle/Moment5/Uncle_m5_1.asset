  Sappy_Observation:
    NpcReactionText:
    - Dialogue: "Trick question, kiddo: no one\u2019s ever ready."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    - Dialogue: All we can do is hope for the best and prepare for everything else.
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "Looks like it, though I wouldn\u2019t call myself ready."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 5
  Charming_Question:
    NpcReactionText:
    - Dialogue: Yeah, your Mom paid me to get you out of here as fast as possible.
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 1232626074937243997, guid: 4bb1702b19683694abd039f4703039a9, type: 3}
      AudioResponse: Silent
    - Dialogue: "...Nah, I\u2019m just joking."
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: Why, are you here to push me out?
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
