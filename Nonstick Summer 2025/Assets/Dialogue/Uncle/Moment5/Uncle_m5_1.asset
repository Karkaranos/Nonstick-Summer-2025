  m_Name: Uncle_m5_1
  m_EditorClassIdentifier: 
  dialogue:
  - Dialogue: Well, would you look at that... all packed and ready to leave the nest?
    Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
    AnimatedReaction: {fileID: 0}
    AudioResponse: Silent
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "If you\u2019re ever back in town, I can show you how to squeeze
        a tent inside a backpack."
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
      AnimatedReaction: {fileID: 3538256414719010168, guid: 6b8dd245a4e1d8c48b2809616a868486, type: 3}
      AudioResponse: Silent
    - Dialogue: Not exactly a house, but it gets the job done.
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: 
    PlayerDialogue: "I meant to pack the whole house, but didn\u2019t have time."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: A little bit of optimism never hurt anyone, you know.
      Portrait: {fileID: 21300000, guid: bb66605723840af4095c1cd31b791acd, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: "But hey, maybe I\u2019m not the one to talk."
      Portrait: {fileID: 21300000, guid: c92eea93dfa7ff647913a78b63731910, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: 'About time. '
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Sappy_Expression:
    NpcReactionText:
    - Dialogue: "No, you won\u2019t. At least, not for long."
      Portrait: {fileID: 21300000, guid: 8783c236d932d0447aba03a16a00820d, type: 3}
      AnimatedReaction: {fileID: 3230480644210021281, guid: 21a34e576288bf148b0d7294986f3034, type: 3}
      AudioResponse: Silent
    - Dialogue: "Don\u2019t worry; I\u2019m fine with that even if it means you forget
        about your weird uncle back home."
      Portrait: {fileID: 21300000, guid: 0ef7c68a92d7e814982c901fc0917414, type: 3}
      AnimatedReaction: {fileID: 0}
      AudioResponse: Silent
    CombinedDialogue: []
    PlayerDialogue: "I\u2019m gonna miss you."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 0
  Charming_Observation:
    NpcReactionText:
    - Dialogue: "Really? If that's the case, you\u2019d better find a bigger box."
