  dialogue:
  - Dialogue: Well, would you look at that...all packed and ready to leave the nest?
    Portrait: {fileID: 21300000, guid: 5b80e3e4b9e4ae24282ce0ed426c2aaa, type: 3}
  Charming_Expression:
    NpcReactionText:
    - Dialogue: "Everyone\u2019s gonna miss you a whole lot, kiddo. Me included."
      Portrait: {fileID: 0}
    CombinedDialogue:
    - Dialogue: "Oh, there\u2019s no need to worry. It has nothing to do you with
        you."
      Portrait: {fileID: 0}
    - Dialogue: My, where has the time gone...
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
    - Dialogue: Who knew that my little Pumpkin could grow so tall?
      Portrait: {fileID: 21300000, guid: 5192d2ae68c371d4c88ca9a5e91ea005, type: 3}
    PlayerDialogue: "I\u2019m sure it\u2019s gonna feel a lot more empty without
      me here."
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: 10
  Assertive_Expression:
    NpcReactionText:
    - Dialogue: A little bit of optimism never hurt anyone, you know. At least, until
        it did.
      Portrait: {fileID: 0}
    CombinedDialogue: []
    PlayerDialogue: More relieved than ready.
    RelationshipCheckRequired: 0
    RelationshipRange: {x: 0, y: 0}
    BranchingDialogueHigh: {fileID: 11400000, guid: 1fb30350f01bdfa489b5e7e7f169ce01, type: 2}
    BranchingDialogueNeutral: {fileID: 0}
    BranchingDialogueLow: {fileID: 0}
    ChangeInRelationshipStatus: -5
