  questionField: {fileID: 2230261468592391674}
  confirmButton: {fileID: 3291965545394272908}
  statement: June 19th, 2008. The last of the boxes have been moved in. Mom feels
    that the move will be good for us. But you...
  question: How do YOU feel?
  yellowOption:
    ButtonText: I can\u2019t wait to see my new home!
    ButtonColor: {r: 1, g: 1, b: 1, a: 1}
    button: {fileID: 2841265330771236776}
  redOption:
    ButtonText: Old home, new home, doesn\u2019t really matter much to me
    ButtonColor: {r: 1, g: 1, b: 1, a: 1}
    button: {fileID: 8854227053318529582}
  blueOption:
    ButtonText: I\u2019m going to miss my old home
    ButtonColor: {r: 1, g: 1, b: 1, a: 1}
    button: {fileID: 4753267857950354706}
